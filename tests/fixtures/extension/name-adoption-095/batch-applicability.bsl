Функция КатегорияПроблемы(Описание, Путь)
 Если Описание = "Object not found: " + Путь Тогда Возврат "missing"; КонецЕсли;
 Если СтрНайти(Описание, "property of " + Путь + " object ") > 0 Тогда
  Если СтрНайти(Описание, "Name property") > 0 Тогда Возврат "name"; КонецЕсли;
  Возврат "property";
 КонецЕсли;
 Возврат "";
КонецФункции

Попытка
 Для Каждого Расш Из РасширенияКонфигурации.Получить() Цикл
  Если Расш.Имя <> "ФормированиеТестовыхДанных" Тогда Продолжить; КонецЕсли;
  Ошибки = Расш.ПроверитьВозможностьПрименения();
  Сообщить("CHECK_COUNT|" + Строка(Ошибки.Количество()));
  Для Каждого Ошибка Из Ошибки Цикл
   Сообщить("ALL_DIAGNOSTIC|" + Ошибка.Описание);
  КонецЦикла;
  Для Каждого ПутьПроба Из СтрРазделить("Language.Русский;DefinedType.GLN;CommonCommand.ИсторияИзменений;Catalog.Валюты;Enum.ТипыКонтактнойИнформации", ";") Цикл
   Пропущено = 0; ИмяОшибки = 0; СвойстваОшибки = 0;
   Для Каждого Ошибка Из Ошибки Цикл
    Категория = КатегорияПроблемы(Ошибка.Описание, ПутьПроба);
    Если Категория = "missing" Тогда Пропущено = Пропущено + 1;
    ИначеЕсли Категория = "name" Тогда ИмяОшибки = ИмяОшибки + 1;
    ИначеЕсли Категория = "property" Тогда СвойстваОшибки = СвойстваОшибки + 1;
    КонецЕсли;
    Если Категория <> "" Тогда Сообщить("TARGET_DIAGNOSTIC|" + ПутьПроба + "|" + Категория + "|" + Ошибка.Описание); КонецЕсли;
   КонецЦикла;
   Сообщить("RESULT|" + ПутьПроба + "|missing=" + Строка(Пропущено) + "|name=" + Строка(ИмяОшибки) + "|other_property=" + Строка(СвойстваОшибки));
  КонецЦикла;
 КонецЦикла;
Исключение
 Сообщить("ERROR|" + ОписаниеОшибки());
КонецПопытки;
