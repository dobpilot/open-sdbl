&НаСервере
Функция СнятьГраницуПробы(КлючПробы, ГраницаПробы)
    ВыводПробы = "";
    Попытка
        ТаблицаПробы = РегистрыНакопления.ЗамерМакетаРегистра.Остатки(ГраницаПробы);
        СуммаПробы = 0;
        Для Каждого СтрокаПробы Из ТаблицаПробы Цикл
            СуммаПробы = СуммаПробы + СтрокаПробы.Сумма;
        КонецЦикла;
        ВыводПробы = "manager." + КлючПробы + Символ(9) + Строка(СуммаПробы) + Символы.ПС;
    Исключение
        ВыводПробы = "manager." + КлючПробы + Символ(9) + "ERROR:" + СтрЗаменить(ОписаниеОшибки(), Символы.ПС, "|") + Символы.ПС;
    КонецПопытки;
    Попытка
        ЗапросПробы = Новый Запрос("ВЫБРАТЬ СуммаОстаток КАК Сумма ИЗ РегистрНакопления.ЗамерМакетаРегистра.Остатки(&Граница) КАК Р");
        ЗапросПробы.УстановитьПараметр("Граница", ГраницаПробы);
        ТаблицаПробы = ЗапросПробы.Выполнить().Выгрузить();
        СуммаПробы = 0;
        Для Каждого СтрокаПробы Из ТаблицаПробы Цикл
            СуммаПробы = СуммаПробы + СтрокаПробы.Сумма;
        КонецЦикла;
        ВыводПробы = ВыводПробы + "query." + КлючПробы + Символ(9) + Строка(СуммаПробы) + Символы.ПС;
    Исключение
        ВыводПробы = ВыводПробы + "query." + КлючПробы + Символ(9) + "ERROR:" + СтрЗаменить(ОписаниеОшибки(), Символы.ПС, "|") + Символы.ПС;
    КонецПопытки;
    Возврат ВыводПробы;
КонецФункции
&НаСервере
Функция ВыполнитьПробу()
    ДатаПробы = Дата(2026, 10, 19, 12, 0, 0);
    СсылкиПробы = Новый Массив;
    МенеджерыПробы = Новый Массив;
    МенеджерыПробы.Добавить(Документы.ЗамерДокумента);
    МенеджерыПробы.Добавить(Документы.ЗамерДокумента);
    МенеджерыПробы.Добавить(Документы.АльфаМомента);
    ИдентификаторыПробы = Новый Массив;
    ИдентификаторыПробы.Добавить("00000000-0000-0000-0000-000000000001");
    ИдентификаторыПробы.Добавить("00000000-0000-0000-0000-000000000002");
    ИдентификаторыПробы.Добавить("00000000-0000-0000-0000-000000000001");
    СистемаПробы = Новый СистемнаяИнформация;
    ВыводПробы = "platform=" + СистемаПробы.ВерсияПриложения + Символы.ПС;
    ВесПробы = 1;
    Для ИндексПробы = 0 По 2 Цикл
        ДокументПробы = МенеджерыПробы[ИндексПробы].СоздатьДокумент();
        ДокументПробы.УстановитьСсылкуНового(МенеджерыПробы[ИндексПробы].ПолучитьСсылку(Новый УникальныйИдентификатор(ИдентификаторыПробы[ИндексПробы])));
        ДокументПробы.Дата = ДатаПробы;
        ДокументПробы.Записать();
        СсылкиПробы.Добавить(ДокументПробы.Ссылка);
        НаборПробы = РегистрыНакопления.ЗамерМакетаРегистра.СоздатьНаборЗаписей();
        НаборПробы.Отбор.Регистратор.Установить(ДокументПробы.Ссылка);
        ЗаписьПробы = НаборПробы.Добавить();
        ЗаписьПробы.Период = ДатаПробы;
        ЗаписьПробы.ВидДвижения = ВидДвиженияНакопления.Приход;
        ЗаписьПробы.Сумма = ВесПробы;
        НаборПробы.Записать();
        ВесПробы = ВесПробы * 10;
        ВыводПробы = ВыводПробы + "document." + Строка(ИндексПробы) + Символ(9) + Строка(ДокументПробы.Ссылка.УникальныйИдентификатор()) + Символы.ПС;
    КонецЦикла;
    ВыводПробы = ВыводПробы + СнятьГраницуПробы("date.before", ДатаПробы - 1);
    ВыводПробы = ВыводПробы + СнятьГраницуПробы("date.raw", ДатаПробы);
    ВыводПробы = ВыводПробы + СнятьГраницуПробы("date.default", Новый Граница(ДатаПробы));
    ВыводПробы = ВыводПробы + СнятьГраницуПробы("date.after", ДатаПробы + 1);
    ВыводПробы = ВыводПробы + СнятьГраницуПробы("date.include", Новый Граница(ДатаПробы, ВидГраницы.Включая));
    ВыводПробы = ВыводПробы + СнятьГраницуПробы("date.exclude", Новый Граница(ДатаПробы, ВидГраницы.Исключая));
    Для ИндексПробы = 0 По 2 Цикл
        МоментПробы = СсылкиПробы[ИндексПробы].МоментВремени();
        КлючПробы = "point." + Строка(ИндексПробы);
        ВыводПробы = ВыводПробы + СнятьГраницуПробы(КлючПробы + ".raw", МоментПробы);
        ВыводПробы = ВыводПробы + СнятьГраницуПробы(КлючПробы + ".default", Новый Граница(МоментПробы));
        ВыводПробы = ВыводПробы + СнятьГраницуПробы(КлючПробы + ".include", Новый Граница(МоментПробы, ВидГраницы.Включая));
        ВыводПробы = ВыводПробы + СнятьГраницуПробы(КлючПробы + ".exclude", Новый Граница(МоментПробы, ВидГраницы.Исключая));
    КонецЦикла;
    МоментыПустотыПробы = Новый Массив;
    МоментыПустотыПробы.Добавить(Новый МоментВремени(ДатаПробы));
    МоментыПустотыПробы.Добавить(Новый МоментВремени(ДатаПробы, Документы.ЗамерДокумента.ПустаяСсылка()));
    МоментыПустотыПробы.Добавить(Новый МоментВремени(ДатаПробы, Документы.АльфаМомента.ПустаяСсылка()));
    Для ИндексПробы = 0 По 2 Цикл
        МоментПробы = МоментыПустотыПробы[ИндексПробы];
        КлючПробы = "empty." + Строка(ИндексПробы);
        ВыводПробы = ВыводПробы + СнятьГраницуПробы(КлючПробы + ".raw", МоментПробы);
        ВыводПробы = ВыводПробы + СнятьГраницуПробы(КлючПробы + ".default", Новый Граница(МоментПробы));
        ВыводПробы = ВыводПробы + СнятьГраницуПробы(КлючПробы + ".include", Новый Граница(МоментПробы, ВидГраницы.Включая));
        ВыводПробы = ВыводПробы + СнятьГраницуПробы(КлючПробы + ".exclude", Новый Граница(МоментПробы, ВидГраницы.Исключая));
    КонецЦикла;
    СтруктураПробы = ПолучитьСтруктуруХраненияБазыДанных();
    Для Каждого СтрокаПробы Из СтруктураПробы Цикл
        Если СтрНайти(Строка(СтрокаПробы.TableName), "ЗамерДокумента") > 0 Или СтрНайти(Строка(СтрокаПробы.TableName), "АльфаМомента") > 0 Тогда
            ВыводПробы = ВыводПробы + "storage." + Строка(СтрокаПробы.TableName) + Символ(9) + Строка(СтрокаПробы.StorageTableName) + Символы.ПС;
        КонецЕсли;
    КонецЦикла;
    Возврат ВыводПробы;
КонецФункции
