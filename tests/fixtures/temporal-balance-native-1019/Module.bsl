Процедура ПриОткрытии(Отказ)
    ПисательПробы = Новый ЗаписьТекста("/home/kan/Документы/develop/open-bsl/target/open-sdbl-0928-delivery/native-preparation/platform.oracle", "UTF-8");
    Попытка
        ПисательПробы.ЗаписатьСтроку(ВыполнитьПробу());
