&НаКлиенте
Процедура ПриОткрытии(Отказ)
    ПисательПробы = Новый ЗаписьТекста("/home/kan/Документы/develop/open-bsl/target/diagnostics/system-settings-native-1015/" + ПараметрЗапуска + ".oracle", "UTF-8");
    Попытка
        ПисательПробы.ЗаписатьСтроку(ВыполнитьПробу(ПараметрЗапуска));
    Исключение
        ПисательПробы.ЗаписатьСтроку("ERROR=" + ОписаниеОшибки());
    КонецПопытки;
    ПисательПробы.ЗаписатьСтроку("completed=YES");
    ПисательПробы.Закрыть();
    ЗавершитьРаботуСистемы(Ложь);
КонецПроцедуры
&НаСервере
Функция ВыполнитьПробу(РежимПробы)
    РежимОбластиПробы = СтрЗаменить(РежимПробы,"-read","");
    ТолькоЧтениеПробы = РежимПробы <> РежимОбластиПробы;
    ПараметрыСеанса.ИспользованиеРазделителяПробы = РежимОбластиПробы <> "root";
    ПараметрыСеанса.ЗначениеРазделителяПробы = РежимОбластиПробы;
    ЧислоСистемыПробы = ?(РежимОбластиПробы = "root",29,?(РежимОбластиПробы = "A",31,37));
    ЧислоОбщихПробы = ЧислоСистемыПробы + 100;
    КлючПробы = "open-bsl-system-settings-control-1015";
    Если Не ТолькоЧтениеПробы Тогда
        ХранилищеСистемныхНастроек.Сохранить(КлючПробы,"scalar",ЧислоСистемыПробы);
        ХранилищеОбщихНастроек.Сохранить(КлючПробы,"scalar",ЧислоОбщихПробы);
    КонецЕсли;
    РезультатПробы = ХранилищеСистемныхНастроек.Загрузить(КлючПробы,"scalar");
    ВыводПробы = "scope=" + РежимПробы + Символы.ПС;
    ВыводПробы = ВыводПробы + "system.scalar=" + Строка(РезультатПробы) + Символы.ПС;
    ВыводПробы = ВыводПробы + "common.scalar=" + Строка(ХранилищеОбщихНастроек.Загрузить(КлючПробы,"scalar")) + Символы.ПС;
    ВыводПробы = ВыводПробы + "system.absent=" + ?(ХранилищеСистемныхНастроек.Загрузить(КлючПробы,"absent") = Неопределено,"YES","NO") + Символы.ПС;
    ОписаниеПробы = "";
    РезультатПробы = ХранилищеСистемныхНастроек.Загрузить(КлючПробы,"scalar",ОписаниеПробы,"OpenBslSettingsAdmin");
    ВыводПробы = ВыводПробы + "system.explicit.same=" + ?(РезультатПробы = ЧислоСистемыПробы,"YES","NO") + Символы.ПС;
    ВыводПробы = ВыводПробы + "system.english=" + ?(SystemSettingsStorage.Load(КлючПробы,"scalar") = ЧислоСистемыПробы,"YES","NO") + Символы.ПС;
    Если Не ТолькоЧтениеПробы Тогда
        ХранилищеСистемныхНастроек.Сохранить(КлючПробы,"storage",Новый ХранилищеЗначения(Новый Структура("Probe",73)));
    КонецЕсли;
    РезультатПробы = ХранилищеСистемныхНастроек.Загрузить(КлючПробы,"storage");
    Возврат ВыводПробы + "system.storage=" + Строка(РезультатПробы.Получить().Probe);
КонецФункции
