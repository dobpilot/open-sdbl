&НаКлиенте
Процедура ПриОткрытии(Отказ)
 ПисательПробы = Новый ЗаписьТекста("/home/kan/Документы/develop/open-bsl/target/diagnostics/system-settings-numeric-native-1015/" + ПараметрЗапуска + ".oracle", "UTF-8");
 Попытка
  ПисательПробы.ЗаписатьСтроку(ВыполнитьПробу(ПараметрЗапуска));
 Исключение
  ПисательПробы.ЗаписатьСтроку("ERROR=" + ОписаниеОшибки());
 КонецПопытки;
 ПисательПробы.ЗаписатьСтроку("completed=YES");
 ПисательПробы.Закрыть();
 ЗавершитьРаботуСистемы(Ложь);
КонецПроцедуры

&НаСервере
Функция ВыполнитьПробу(РежимПробы)
 УсловиеПробы = Не (Лев(РежимПробы, 4) = "off-");
 Константы.ЗначениеОпцииПробы.Установить(УсловиеПробы);
 ИспользованиеПробы = Не (РежимПробы = "on-inactive-read" Или РежимПробы = "off-inactive-read");
 Если РежимПробы <> "off-unset-use-read" Тогда
  ПараметрыСеанса.ИспользованиеРазделителяПробы = ИспользованиеПробы;
 КонецЕсли;
 Если ИспользованиеПробы И РежимПробы <> "off-no-value-read" И РежимПробы <> "off-unset-use-read" Тогда
  ПараметрыСеанса.ЗначениеРазделителяПробы = ?(РежимПробы = "on-empty-read", 0, ?(РежимПробы = "on-b-write", 202, 101));
 КонецЕсли;
 КлючПробы = "conditional-shared";
 ЗначениеПробы = ХранилищеСистемныхНастроек.Загрузить("open-bsl-system-settings-numeric-control-1015",КлючПробы);
 ВыводПробы = "before=" + ?(ЗначениеПробы = Неопределено, "MISSING", Строка(ЗначениеПробы)) + Символы.ПС;
 Если РежимПробы = "off-write" Или РежимПробы = "on-a-write" Или РежимПробы = "on-b-write" Тогда
  ЧислоПробы = ?(РежимПробы = "off-write",20,?(РежимПробы = "on-a-write",21,22));
  ХранилищеСистемныхНастроек.Сохранить("open-bsl-system-settings-numeric-control-1015",КлючПробы,ЧислоПробы);
 КонецЕсли;
 ЗначениеПробы = ХранилищеСистемныхНастроек.Загрузить("open-bsl-system-settings-numeric-control-1015",КлючПробы);
 Возврат ВыводПробы + "after=" + ?(ЗначениеПробы = Неопределено, "MISSING", Строка(ЗначениеПробы)) + Символы.ПС;
КонецФункции
