&НаКлиенте
Процедура ПриОткрытии(Отказ)
    ПисательПробы = Новый ЗаписьТекста("__RESULT_DIRECTORY__/legacy-language-" + ПараметрЗапуска + ".oracle", "UTF-8");
    Попытка
        ПисательПробы.ЗаписатьСтроку(ПрочитатьЯзыкиПробы());
    Исключение
        ПисательПробы.ЗаписатьСтроку("ERROR=" + ОписаниеОшибки());
    КонецПопытки;
    ПисательПробы.ЗаписатьСтроку("completed=YES");
    ПисательПробы.Закрыть();
    ЗавершитьРаботуСистемы(Ложь);
КонецПроцедуры

&НаСервере
Функция ПрочитатьЯзыкиПробы()
    ИменаПробы = Новый Массив;
    ИменаПробы.Добавить("LangRussian");
    ИменаПробы.Добавить("LangEnglish");
    ИменаПробы.Добавить("LangDefault");
    ВыводПробы = "";
    Для Каждого ИмяПробы Из ИменаПробы Цикл
        ПользовательПробы = ПользователиИнформационнойБазы.НайтиПоИмени(ИмяПробы);
        Если ПользовательПробы.Язык = Неопределено Тогда
            ПредставлениеПробы = "<undefined>";
        Иначе
            ПредставлениеПробы = ПользовательПробы.Язык.Имя;
        КонецЕсли;
        ВыводПробы = ВыводПробы + ИмяПробы + "=" + ПредставлениеПробы + Символы.ПС;
    КонецЦикла;
    ВыводПробы = ВыводПробы + "PRIMARY=" + Метаданные.ОсновнойЯзык.Имя + Символы.ПС;
    ВыводПробы = ВыводПробы + "CURRENT=" + ТекущийЯзык().Имя + Символы.ПС;
    ВыводПробы = ВыводПробы + "ALIASES=" + ?(ТекущийЯзык() = CurrentLanguage(), "YES", "NO") + Символы.ПС;
    Возврат ВыводПробы;
КонецФункции
