// PLATFORM-ONLY: условие разделения и выключенный независимый разделитель.

Процедура М(Ид, Значение)
    Сообщить(Ид + Символ(9) + Строка(Значение));
КонецПроцедуры

Функция ПробаЗапроса()
    Попытка
        ЗапросПробы = Новый Запрос("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Количество ИЗ Справочник.ЗамерВременныхТаблиц");
        ЗапросПробы.Выполнить();
        Возврат "ok";
    Исключение
        Возврат "error:" + ОписаниеОшибки();
    КонецПопытки;
КонецФункции

Функция КоличествоПробы()
    ЗапросПробы = Новый Запрос("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Количество ИЗ Справочник.ЗамерВременныхТаблиц");
    ВыборкаПробы = ЗапросПробы.Выполнить().Выбрать();
    ВыборкаПробы.Следующий();
    Возврат ВыборкаПробы.Количество;
КонецФункции

Функция ИменаПробы()
    ЗапросПробы = Новый Запрос("ВЫБРАТЬ Наименование КАК Имя ИЗ Справочник.ЗамерВременныхТаблиц УПОРЯДОЧИТЬ ПО Имя");
    ВыборкаПробы = ЗапросПробы.Выполнить().Выбрать();
    РезультатИменПробы = "";
    Пока ВыборкаПробы.Следующий() Цикл
        РезультатИменПробы = РезультатИменПробы + ВыборкаПробы.Имя + ";";
    КонецЦикла;
    Возврат РезультатИменПробы;
КонецФункции

М("file.begin", "common-attribute-conditional-separation-number-1");
Попытка
    М("conditional.initial_constant", ?(Константы.ЗначениеОпцииПробы.Получить(), "true", "false"));
    М("conditional.metadata_identity", Метаданные.ОбщиеРеквизиты.НаименованиеЯзык1.УсловноеРазделение = Метаданные.Константы.ЗначениеОпцииПробы);
    М("conditional.initial_use", ?(ПараметрыСеанса.ИспользованиеРазделителяПробы, "true", "false"));
    М("conditional.initial_query", ПробаЗапроса());
    ЭлементПустойОбласти = Справочники.ЗамерВременныхТаблиц.СоздатьЭлемент();
    ЭлементПустойОбласти.Наименование = "empty";
    ЭлементПустойОбласти.Записать();
    М("conditional.initial_empty_count", КоличествоПробы());
    Константы.ЗначениеОпцииПробы.Установить(Истина);
    М("conditional.constant_after_write", ?(Константы.ЗначениеОпцииПробы.Получить(), "true", "false"));
    М("conditional.query_after_write", ПробаЗапроса());
    ПараметрыСеанса.ИспользованиеРазделителяПробы = Истина;
    ПараметрыСеанса.ЗначениеРазделителяПробы = 1;
    М("conditional.query_use_true", ПробаЗапроса());
    ПараметрыСеанса.ИспользованиеРазделителяПробы = Ложь;
    М("conditional.query_use_false", ПробаЗапроса());
    ПараметрыСеанса.ИспользованиеРазделителяПробы = Истина;
    Для Каждого ЗначениеПробы Из СтрРазделить("A,B", ",") Цикл
        ПараметрыСеанса.ЗначениеРазделителяПробы = ?(ЗначениеПробы = "A", 1, 2);
        ЭлементПробы = Справочники.ЗамерВременныхТаблиц.СоздатьЭлемент();
        ЭлементПробы.Наименование = ЗначениеПробы;
        ЭлементПробы.Записать();
    КонецЦикла;
    М("conditional.enabled_b_count", КоличествоПробы());
    М("conditional.enabled_b_names", ИменаПробы());
    Константы.ЗначениеОпцииПробы.Установить(Ложь);
    М("conditional.disabled_b_count", КоличествоПробы());
    ПараметрыСеанса.ЗначениеРазделителяПробы = 3;
    М("conditional.disabled_c_count", КоличествоПробы());
    М("conditional.disabled_c_names", ИменаПробы());
    ПараметрыСеанса.ИспользованиеРазделителяПробы = Ложь;
    М("conditional.disabled_use_false_count", КоличествоПробы());
    Константы.ЗначениеОпцииПробы.Установить(Истина);
    М("conditional.reenabled_use_false_query", ПробаЗапроса());
Исключение
    М("conditional.control_error", ОписаниеОшибки());
КонецПопытки;
М("file.end", "common-attribute-conditional-separation-number-1");
