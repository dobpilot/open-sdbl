

// Приёмник вывода: дописывает строку в файл. Открытие на каждой строке —
// сознательно: строк меньше сотни, зато нет ни модульных переменных, ни
// зависимости от того, переживает ли что-то серверный вызов.
&НаСервереБезКонтекста
Процедура СообщитьВФайл(Текст)
	Ф = Новый ЗаписьТекста("/tmp/tmp.JiP6GNr4Kz/platform-output.tsv", , , Истина);
	Ф.ЗаписатьСтроку(Строка(Текст));
	Ф.Закрыть();
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ОчиститьФайлВывода()
	// Файл создаётся заново на каждом прогоне — иначе замеры копились бы.
	ФайлВывода = Новый ЗаписьТекста("/tmp/tmp.JiP6GNr4Kz/platform-output.tsv");
	ФайлВывода.Закрыть();
КонецПроцедуры

&НаСервере
Процедура СоздатьПользователяПробы(ИмяПробы, РольПробы)
    ПользовательПробы = ПользователиИнформационнойБазы.СоздатьПользователя();
    ПользовательПробы.Имя = ИмяПробы;
    ПользовательПробы.АутентификацияСтандартная = Истина;
    ПользовательПробы.Пароль = "";
    Попытка
        ПользовательПробы.ПолноеИмя = "Native " + ИмяПробы;
    Исключение
        СообщитьВФайл("FULLNAME.SETUP=ERROR:" + ОписаниеОшибки());
    КонецПопытки;
    ПользовательПробы.Роли.Добавить(Метаданные.Роли.Найти(РольПробы));
    ПользовательПробы.Записать();
КонецПроцедуры

&НаСервере
Функция ЗапросПробы()
    Попытка
        ЗапросПробы = Новый Запрос("ВЫБРАТЬ Ссылка, Заполняемый ИЗ Документ.ЗамерДокумента ГДЕ Заполняемый = &Значение");
        ЗапросПробы.УстановитьПараметр("Значение", "AbC");
        ВыборкаПробы = ЗапросПробы.Выполнить().Выбрать();
        Если ВыборкаПробы.Следующий() Тогда
            Возврат Строка(ВыборкаПробы.Ссылка.УникальныйИдентификатор()) + ";" + ВыборкаПробы.Заполняемый;
        КонецЕсли;
        Возврат "EMPTY";
    Исключение
        Возврат "ERROR:" + ОписаниеОшибки();
    КонецПопытки;
КонецФункции

&НаСервере
Функция ПоискПробы()
    Попытка
        СсылкаПробы = Документы.ЗамерДокумента.НайтиПоРеквизиту("Заполняемый", "AbC");
        Возврат Строка(СсылкаПробы.УникальныйИдентификатор());
    Исключение
        Возврат "ERROR:" + ОписаниеОшибки();
    КонецПопытки;
КонецФункции

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ВыполнитьТестНаСервере();
	ЗавершитьРаботуСистемы(Ложь);
КонецПроцедуры

&НаСервере
Процедура ВыполнитьТестНаСервере()
	ОчиститьФайлВывода();




	Попытка
	    Если ИмяПользователя() = "" Тогда
	        ДокументПробы = Документы.ЗамерДокумента.СоздатьДокумент();
	        ДокументПробы.Дата = Дата(2026, 10, 17);
	        ДокументПробы.Заполняемый = "AbC";
	        ДокументПробы.УстановитьСсылкуНового(Документы.ЗамерДокумента.ПолучитьСсылку(Новый УникальныйИдентификатор("12345678-1234-4321-abcd-0123456789ab")));
	        ДокументПробы.Записать();
	        СоздатьПользователяПробы("DocFieldsAdmin", "ControlAdmin");
	        СоздатьПользователяПробы("DocFieldsReadOff", "ControlReadOff");
	        СоздатьПользователяПробы("DocFieldsReadOn", "ControlReadOn");
	        СоздатьПользователяПробы("DocFieldsDenied", "ControlDenied");
	        СообщитьВФайл("SETUP=OK");
	    Иначе
	        СообщитьВФайл("USER=" + ИмяПользователя());
	        СообщитьВФайл("FULLNAME=" + ПолноеИмяПользователя());
	        СообщитьВФайл("PRIVILEGED=" + ?(ПривилегированныйРежим(), "YES", "NO"));
	        СообщитьВФайл("READ=" + ?(ПравоДоступа("Чтение", Метаданные.Документы.ЗамерДокумента), "YES", "NO"));
	        СообщитьВФайл("QUERY=" + ЗапросПробы());
	        СообщитьВФайл("FIND=" + ПоискПробы());
	    КонецЕсли;
	Исключение
	    СообщитьВФайл("PROBE=ERROR:" + ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры
