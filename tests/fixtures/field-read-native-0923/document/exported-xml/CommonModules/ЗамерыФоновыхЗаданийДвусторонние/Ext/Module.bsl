// Двусторонние цели скрипта tests/conformance/measure/measure-background-jobs.bsl:
// модуль исполняется и платформой (в составе cfg-src-server), и open-bsl
// (runner — тест the_background_jobs_measure_script_runs_with_the_platform_catalog
// в crates/open-bsl/tests/measure_scripts.rs). Поэтому здесь только
// конструкции, которые компилируют ОБЕ стороны: ни «Новый Файл» с
// файловыми барьерами (их open-bsl пока не знает — они остаются в
// platform-only модуле ЗамерыФоновыхЗаданий), ни модификатора Асинх.
// ИЗМЕРЕНО сессией 2026-08-27 на файловой базе: «Асинх Процедура» в
// серверном общем модуле проходит загрузку конфигурации МОЛЧА, но
// ломает инициализацию всего модуля при первом обращении («Ошибка
// инициализации модуля») — каждая цель модуля падает. Поэтому проба
// JOB.ASYNC.TARGET зовёт намеренно отсутствующий метод, а объявление
// сюда не возвращать. Тело модуля-соседа (ЗамерыФоновыйСосед) ломает
// тем же образом ТОЛЬКО его самого — он и служит пробой
// JOB.MODULE.INIT.КАСАНИЕ.

// Быстрая цель без параметров — проба порядка листинга и границы
// отбора «Начало» (JOB.LIST.FILTER_ORDER).
Процедура Пустая() Экспорт
КонецПроцедуры

// Соседей не касается: проба инициализации тел модулей (JOB.MODULE.INIT)
// наблюдает сообщения задания.
Процедура СоседИнициализирован() Экспорт
КонецПроцедуры

// Пишет по адресу вызывателя и тут же читает его — проба
// JOB.TEMP.READ_YOUR_WRITES.
Процедура ПисатьИЧитать(Адрес) Экспорт
	ПоместитьВоВременноеХранилище("своя запись", Адрес);
	Чтение = ПолучитьИзВременногоХранилища(Адрес);
	Сообщить(?(Чтение = Неопределено, "Неопределено", Строка(Чтение)));
КонецПроцедуры

// Удаляет адрес вызывателя — проба JOB.TEMP.STAGED_DELETE.
Процедура УдалитьАдрес(Адрес) Экспорт
	УдалитьИзВременногоХранилища(Адрес);
КонецПроцедуры

// Внук пробует писать по адресу исходного foreground-сеанса — проба
// JOB.TEMP.NESTED_CAPABILITY; ошибка чужого адреса гасится, наблюдение
// ведёт вызыватель по значению адреса.
Процедура ВнукПишет(Адрес) Экспорт
	Попытка
		ПоместитьВоВременноеХранилище("от внука", Адрес);
	Исключение
	КонецПопытки;
КонецПроцедуры

Процедура РодительВнука(Адрес) Экспорт
	Параметры = Новый Массив;
	Параметры.Добавить(Адрес);
	Внук = ФоновыеЗадания.Выполнить("ЗамерыФоновыхЗаданийДвусторонние.ВнукПишет", Параметры);
	Внук.ОжидатьЗавершенияВыполнения(30);
КонецПроцедуры

// Контрольное касание соседа: инициализирует его тело первым обращением
// — подзамер JOB.MODULE.INIT.КАСАНИЕ.
Процедура КоснутьсяСоседа() Экспорт
	Сообщить("отклик: " + Строка(ЗамерыФоновыйСосед.Отклик()));
КонецПроцедуры
