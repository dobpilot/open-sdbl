// Проверка ленивой ошибки арности при вызове экспортов общего модуля.
Функция Значение() Экспорт
	Возврат 42;
КонецФункции

Функция Исправный() Экспорт
	Возврат ЗамерыЛенивойАрности.Значение();
КонецФункции

Функция НевернаяЛокальнаяАрность() Экспорт
	Возврат ЗамерыЛенивойАрности.Значение(1, 2);
КонецФункции

Функция НевернаяВнешняяАрность() Экспорт
	Возврат ЗамерыСамоссылкиМодуля.ВнутреннееЗначение(1, 2);
КонецФункции

Функция Обязательный(Первый, Второй) Экспорт
	Возврат Первый + Второй;
КонецФункции

Функция ПропущенЛокальный() Экспорт
	Возврат ЗамерыЛенивойАрности.Обязательный(1);
КонецФункции

Функция ПропущенВнешний() Экспорт
	Возврат ЗамерыЗначенияМодуля.ПропуститьОбязательный(1);
КонецФункции
