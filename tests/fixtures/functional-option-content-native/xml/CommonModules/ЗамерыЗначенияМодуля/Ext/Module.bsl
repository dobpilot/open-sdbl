Функция Проверить() Экспорт
	Результат = Новый Структура("Ошибка,После", Ложь, 0);
	Попытка
		СсылкаНаМодуль = ЗамерыФоновыйСосед;
		Результат.После = 1;
	Исключение
		Результат.Ошибка = Истина;
	КонецПопытки;
	Возврат Результат;
КонецФункции

Функция ПропуститьОбязательный(Первый, Второй, Третий) Экспорт
	Возврат Строка(Первый) + "|" + Строка(Второй = Неопределено) + "|" + Строка(Третий);
КонецФункции
