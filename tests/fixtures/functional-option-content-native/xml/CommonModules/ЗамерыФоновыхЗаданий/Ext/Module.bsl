Процедура ЗаписатьМаркер(Путь, Текст)
	Поток = Новый ЗаписьТекста(Путь);
	Поток.ЗаписатьСтроку(Текст);
	Поток.Закрыть();
КонецПроцедуры

Процедура ЗаписатьИЗавершитьсяСОшибкой(Адрес) Экспорт
	ПоместитьВоВременноеХранилище("from-failed-job", Адрес);
	ВызватьИсключение "expected job failure";
КонецПроцедуры

Процедура ЗаписатьИОжидатьОтмены(Адрес, ПутьЗаписано) Экспорт
	ПоместитьВоВременноеХранилище("from-canceled-job", Адрес);
	ЗаписатьМаркер(ПутьЗаписано, "written");
	Пока Истина Цикл
		Для СчетчикОтмены = 1 По 1000000 Цикл
			ПромежутокОтмены = СчетчикОтмены * 2;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

Функция ОписаниеЗначенияQ78(ЗначениеQ78)
	Возврат Строка(ТипЗнч(ЗначениеQ78)) + ":" + Строка(ЗначениеQ78);
КонецФункции

Процедура СоздатьЧужиеАдресаИОжидать(ПутьАдресов, ПутьРазрешения, ПутьПроверки) Экспорт
	АдресЧтенияQ78 = ПоместитьВоВременноеХранилище("job-read");
	АдресУдаленияQ78 = ПоместитьВоВременноеХранилище("job-delete");
	АдресЗаписиQ78 = ПоместитьВоВременноеХранилище("job-write");
	ЗаписатьМаркер(ПутьАдресов,
		АдресЧтенияQ78 + Символы.ПС
		+ АдресУдаленияQ78 + Символы.ПС
		+ АдресЗаписиQ78);

	Пока Истина Цикл
		ФайлРазрешенияQ78 = Новый Файл(ПутьРазрешения);
		Если ФайлРазрешенияQ78.Существует() Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;

	ЗаписатьМаркер(ПутьПроверки,
		ОписаниеЗначенияQ78(ПолучитьИзВременногоХранилища(АдресЧтенияQ78)) + Символы.ПС
		+ ОписаниеЗначенияQ78(ПолучитьИзВременногоХранилища(АдресУдаленияQ78)) + Символы.ПС
		+ ОписаниеЗначенияQ78(ПолучитьИзВременногоХранилища(АдресЗаписиQ78)));
КонецПроцедуры

Процедура ПередатьЧерезВременноеХранилище(Адрес, ПутьНаблюдения, ПутьЗаписано, ПутьРазрешения) Экспорт
	Попытка
		ЗначениеДоЗаписи = ПолучитьИзВременногоХранилища(Адрес);
		ЗаписатьМаркер(ПутьНаблюдения, Строка(ТипЗнч(ЗначениеДоЗаписи)) + ":" + Строка(ЗначениеДоЗаписи));

		ВозвращенныйАдрес = ПоместитьВоВременноеХранилище("from-job", Адрес);
		ЗаписатьМаркер(ПутьЗаписано, Строка(ВозвращенныйАдрес = Адрес));

		Пока Истина Цикл
			ФайлРазрешения = Новый Файл(ПутьРазрешения);
			Если ФайлРазрешения.Существует() Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
	Исключение
		ЗаписатьМаркер(ПутьЗаписано, "ERROR:" + ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

Процедура ОтменяемаяРабота(ПутьСтарта, ПутьОбработчика, ПутьПосле) Экспорт
	ЗаписатьМаркер(ПутьСтарта, "started");

	Попытка
		Пока Истина Цикл
			Промежуток = 0;
			Для Счетчик = 1 По 1000000 Цикл
				Промежуток = Промежуток + Счетчик;
			КонецЦикла;
		КонецЦикла;
	Исключение
		ЗаписатьМаркер(ПутьОбработчика, "caught");
	КонецПопытки;

	ЗаписатьМаркер(ПутьПосле, "after");
КонецПроцедуры
// Неглобальный серверный общий модуль — цель фоновых заданий в замерах
// JOB.* (план bsl-background-jobs.md, этап 0). Изменение модуля меняет
// конфигурацию измерительной базы при следующем прогоне раннера.

// Занятое ожидание вместо паузы: штатной паузы в BSL нет, а задание
// должно жить достаточно долго для снимков состояния.
Процедура Долгая(МсРабота) Экспорт
	Крайний = ТекущаяУниверсальнаяДатаВМиллисекундах() + МсРабота;
	Пока ТекущаяУниверсальнаяДатаВМиллисекундах() < Крайний Цикл
	КонецЦикла;
КонецПроцедуры

// Быстрая цель без параметров.
Процедура Пустая() Экспорт
КонецПроцедуры

// Цель с хвостовым умолчанием — проба JOB.EXECUTE.DEFAULTS: пишет
// фактическое значение необязательного параметра по адресу вызывателя.
Процедура Хвост(Адрес, Необязательный = 7) Экспорт
	ПоместитьВоВременноеХранилище(Необязательный, Адрес);
КонецПроцедуры

// Неэкспортная процедура — проба видимости цели.
Процедура Скрытая()
КонецПроцедуры

// Функция-цель: допустимость и судьба возвращаемого значения.
Функция Значение() Экспорт
	Возврат 41;
КонецФункции

// Пишет в хранилище по адресу вызывателя — канал наблюдения из формы.
Процедура ВХранилище(Адрес, Значение) Экспорт
	ПоместитьВоВременноеХранилище(Значение, Адрес);
КонецПроцедуры

// Измеряет режим запуска именно внутри фонового задания, а не в вызывающем
// клиентском сеансе.
Процедура РежимЗапускаВХранилище(Адрес) Экспорт
	Режим = ТекущийРежимЗапуска();
	Результат = Строка(ТипЗнч(Режим)) + ":" + Строка(Режим);
	ПоместитьВоВременноеХранилище(Результат, Адрес);
КонецПроцедуры

// Снимает тип клиентского приложения внутри фонового сеанса.
Процедура ТипКлиентскогоПриложенияВХранилище(Адрес) Экспорт
	Попытка
		ТипПриложенияПробы = КлиентскоеПриложение.ТипПриложения();
		Результат = Строка(ТипЗнч(КлиентскоеПриложение)) + ":"
			+ Строка(ТипЗнч(ТипПриложенияПробы)) + ":" + Строка(ТипПриложенияПробы);
	Исключение
		Результат = "ERROR:" + ОписаниеОшибки();
	КонецПопытки;
	ПоместитьВоВременноеХранилище(Результат, Адрес);
КонецПроцедуры

// Снимает результат функции экранов в настоящем фоновом сеансе.
Процедура ЭкраныКлиентаВХранилище(Адрес) Экспорт
	Экраны = ПолучитьИнформациюЭкрановКлиента();
	ПоместитьВоВременноеХранилище(
		Строка(ТипЗнч(Экраны)) + ":" + Строка(Экраны), Адрес);
КонецПроцедуры

// Снимает вариант интерфейса внутри отдельного фонового сеанса.
Процедура ВариантИнтерфейсаВХранилище(Адрес) Экспорт
	Попытка
		ВариантПробы = ТекущийВариантИнтерфейсаКлиентскогоПриложения();
		Результат = Строка(ТипЗнч(ВариантПробы)) + ":" + Строка(ВариантПробы);
	Исключение
		Результат = "ERROR";
	КонецПопытки;
	ПоместитьВоВременноеХранилище(Результат, Адрес);
КонецПроцедуры

// Измеряет связь сеанса с тем фоновым заданием, которое его создало.
Процедура КонтекстСеансаВХранилище(Адрес) Экспорт
	Сеанс = ПолучитьТекущийСеансИнформационнойБазы();
	Задание = Сеанс.ПолучитьФоновоеЗадание();
	Результат = Строка(ТипЗнч(Сеанс)) + "|"
		+ Строка(ТипЗнч(Задание)) + "|" + Задание.ИмяМетода;
	ПоместитьВоВременноеХранилище(Результат, Адрес);
КонецПроцедуры

// Сообщения пользователю — проба JOB.MESSAGES.
Процедура Говорит() Экспорт
	Сообщить("первое");
	Сообщить("второе");
КонецПроцедуры

// Смотрит на переданный массив — проба момента снимка параметров.
Процедура СчитаетМассив(Адрес, Массив) Экспорт
	ПоместитьВоВременноеХранилище(Массив.Количество(), Адрес);
КонецПроцедуры

// Родитель порождает ребёнка и ждёт его — проба JOB.NESTED.WAIT.
Процедура Родитель(Адрес) Экспорт
	Параметры = Новый Массив;
	Параметры.Добавить(Адрес);
	Параметры.Добавить("от-ребёнка");
	Дитя = ФоновыеЗадания.Выполнить("ЗамерыФоновыхЗаданий.ВХранилище", Параметры);
	Дитя.ОжидатьЗавершенияВыполнения(30);
КонецПроцедуры

// Падает — проба JOB.STATE.ERROR.
Процедура Падает() Экспорт
	ВызватьИсключение "намеренное падение";
КонецПроцедуры
