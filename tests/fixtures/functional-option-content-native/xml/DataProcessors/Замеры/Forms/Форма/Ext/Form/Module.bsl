

// Приёмник вывода: дописывает строку в файл. Открытие на каждой строке —
// сознательно: строк меньше сотни, зато нет ни модульных переменных, ни
// зависимости от того, переживает ли что-то серверный вызов.
&НаСервереБезКонтекста
Процедура СообщитьВФайл(Текст)
	Ф = Новый ЗаписьТекста("/tmp/tmp.R00efQaPG0/platform-output.tsv", , , Истина);
	Ф.ЗаписатьСтроку(Строка(Текст));
	Ф.Закрыть();
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ОчиститьФайлВывода()
	// Файл создаётся заново на каждом прогоне — иначе замеры копились бы.
	ФайлВывода = Новый ЗаписьТекста("/tmp/tmp.R00efQaPG0/platform-output.tsv");
	ФайлВывода.Закрыть();
КонецПроцедуры

&НаСервере
Процедура М(Ид, Значение)
 СообщитьВФайл(Ид + Символ(9) + Строка(Значение));
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ВыполнитьТестНаСервере();
	ЗавершитьРаботуСистемы(Ложь);
КонецПроцедуры

&НаСервере
Процедура ВыполнитьТестНаСервере()
	ОчиститьФайлВывода();

	М("file.begin", "functional-option-content-1");
	Попытка
	 ОпцияЛожь = Метаданные.ФункциональныеОпции.ОпцияПробы;
	 ОпцияИстина = Метаданные.ФункциональныеОпции.ОпцияПробыПривилегированная;
	 М("FUNCTIONAL_OPTION.CONTENT.FALSE_COUNT", ОпцияЛожь.Состав.Количество());
	 М("FUNCTIONAL_OPTION.CONTENT.TRUE_COUNT", ОпцияИстина.Состав.Количество());
	 М("FUNCTIONAL_OPTION.CONTENT.FALSE_LOCATION", ОпцияЛожь.Хранение.ПолноеИмя());
	 М("FUNCTIONAL_OPTION.CONTENT.TRUE_LOCATION", ОпцияИстина.Хранение.ПолноеИмя());
	 М("FUNCTIONAL_OPTION.CONTENT.FALSE_MODE", ОпцияЛожь.ПривилегированныйРежимПриПолучении);
	 М("FUNCTIONAL_OPTION.CONTENT.TRUE_MODE", ОпцияИстина.ПривилегированныйРежимПриПолучении);
	Исключение
	 М("FUNCTIONAL_OPTION.CONTENT.ERROR", ОписаниеОшибки());
	КонецПопытки;
	М("file.end", "functional-option-content-1");
КонецПроцедуры
