Функция ИзмеритьФлаг() Экспорт
    Если ИмяПользователя() = "" Тогда
        Для Каждого ИмяКонтроля Из ИменаПользователейКонтроля() Цикл
            ПользовательКонтроля = ПользователиИнформационнойБазы.СоздатьПользователя();
            ПользовательКонтроля.Имя = ИмяКонтроля;
            ПользовательКонтроля.АутентификацияСтандартная = Истина;
            ПользовательКонтроля.Роли.Добавить(Метаданные.Роли[?(ИмяКонтроля = "Target", "ControlClient", "ControlAdmin")]);
            ПользовательКонтроля.Записать();
        КонецЦикла;
        НаборКонтроля = РегистрыСведений.ОпцииПробы.СоздатьНаборЗаписей();
        СтрокаКонтроля = НаборКонтроля.Добавить();
        СтрокаКонтроля.ПервыйКлюч = 1;
        СтрокаКонтроля.ВторойКлюч = 1;
        СтрокаКонтроля.ПризнакОпции = Истина;
        СтрокаКонтроля.ЧислоОпции = 17;
        НаборКонтроля.Записать();
        Возврат "bootstrap=YES";
    КонецЕсли;
    Возврат РегистрыСведений.ОпцииПробы.ПроверитьЧтение();
КонецФункции
Функция ИменаПользователейКонтроля()
    МассивКонтроля = Новый Массив;
    МассивКонтроля.Добавить("ControlAdministrator");
    МассивКонтроля.Добавить("Target");
    Возврат МассивКонтроля;
КонецФункции
