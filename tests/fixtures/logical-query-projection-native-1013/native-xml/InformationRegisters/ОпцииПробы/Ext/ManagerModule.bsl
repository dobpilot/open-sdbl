Функция ДополнительнаяПроба(ИмяПробы, ТекстЗапроса)
    Попытка
        РезультатКонтроля = Новый Запрос(ТекстЗапроса);
        РезультатКонтроля = РезультатКонтроля.Выполнить();
        ВыводПробы = ИмяПробы + ".columns=" + Строка(РезультатКонтроля.Колонки.Количество()) + ";name=" + РезультатКонтроля.Колонки[0].Имя + Символы.ПС;
        ВыборкаПробы = РезультатКонтроля.Выбрать();
        НомерПробы = 0;
        Пока ВыборкаПробы.Следующий() Цикл
            НомерПробы = НомерПробы + 1;
            ВыводПробы = ВыводПробы + ИмяПробы + ".row=" + Строка(НомерПробы) + ";type=" + Строка(ТипЗнч(ВыборкаПробы.ЧислоОпции)) + ";value=" + Строка(ВыборкаПробы.ЧислоОпции) + Символы.ПС;
        КонецЦикла;
        Возврат ВыводПробы + ИмяПробы + ".rows=" + Строка(НомерПробы) + Символы.ПС;
    Исключение
        Возврат ИмяПробы + ".ERROR=" + ОписаниеОшибки() + Символы.ПС;
    КонецПопытки;
КонецФункции
Функция ПробаЧтения(ФазаКонтроля)
    Вывод = ФазаКонтроля + ".privileged=" + ?(ПривилегированныйРежим(), "YES", "NO") + Символы.ПС;
    Вывод = Вывод + ФазаКонтроля + ".safe=" + ?(БезопасныйРежим(), "YES", "NO") + Символы.ПС;
    Вывод = Вывод + ФазаКонтроля + ".permission.read=" + ?(ПравоДоступа("Чтение", Метаданные.РегистрыСведений.ОпцииПробы), "YES", "NO") + Символы.ПС;
    Попытка
        ЗапросКонтроля = Новый Запрос("ВЫБРАТЬ ЛОЖЬ КАК ЧислоОпции ИЗ РегистрСведений.ОпцииПробы ОБЪЕДИНИТЬ ВСЕ ВЫБРАТЬ ИСТИНА ИЗ РегистрСведений.ОпцииПробы ОБЪЕДИНИТЬ ВСЕ ВЫБРАТЬ ""native-string"" ИЗ РегистрСведений.ОпцииПробы");
        РезультатКонтроля = ЗапросКонтроля.Выполнить();
        Вывод = Вывод + ФазаКонтроля + ".columns=" + Строка(РезультатКонтроля.Колонки.Количество()) + ";name=" + РезультатКонтроля.Колонки[0].Имя + Символы.ПС;
        ВыборкаКонтроля = РезультатКонтроля.Выбрать();
        НомерСтрокиКонтроля = 0;
        Пока ВыборкаКонтроля.Следующий() Цикл
            НомерСтрокиКонтроля = НомерСтрокиКонтроля + 1;
            Вывод = Вывод + ФазаКонтроля + ".row=" + Строка(НомерСтрокиКонтроля) + ";type=" + Строка(ТипЗнч(ВыборкаКонтроля.ЧислоОпции)) + ";value=" + Строка(ВыборкаКонтроля.ЧислоОпции) + Символы.ПС;
        КонецЦикла;
        Вывод = Вывод + ФазаКонтроля + ".rows=" + Строка(НомерСтрокиКонтроля) + Символы.ПС;
    Исключение
        Вывод = Вывод + ФазаКонтроля + ".query=REFUSED:" + ОписаниеОшибки() + Символы.ПС;
    КонецПопытки;
    Возврат Вывод;
КонецФункции
Функция ПроверитьЧтение() Экспорт
    Вывод = "user=" + ИмяПользователя() + Символы.ПС;
    Вывод = Вывод + "role.client=" + ?(РольДоступна("ControlClient"), "YES", "NO") + Символы.ПС;
    Вывод = Вывод + "role.admin=" + ?(РольДоступна("ControlAdmin"), "YES", "NO") + Символы.ПС;
    Вывод = Вывод + ПробаЧтения("normal.before");
    УстановитьПривилегированныйРежим(Истина);
    Вывод = Вывод + ПробаЧтения("privileged.on");
    Вывод = Вывод + ДополнительнаяПроба("caseBS", "ВЫБРАТЬ ВЫБОР КОГДА ИСТИНА ТОГДА ЛОЖЬ ИНАЧЕ ""native-string"" КОНЕЦ КАК ЧислоОпции ИЗ РегистрСведений.ОпцииПробы");
    Вывод = Вывод + ДополнительнаяПроба("unionNull", "ВЫБРАТЬ NULL КАК ЧислоОпции ИЗ РегистрСведений.ОпцииПробы ОБЪЕДИНИТЬ ВСЕ ВЫБРАТЬ ""native-string"" ИЗ РегистрСведений.ОпцииПробы");
    Вывод = Вывод + ДополнительнаяПроба("unionUndefined", "ВЫБРАТЬ НЕОПРЕДЕЛЕНО КАК ЧислоОпции ИЗ РегистрСведений.ОпцииПробы ОБЪЕДИНИТЬ ВСЕ ВЫБРАТЬ ""native-string"" ИЗ РегистрСведений.ОпцииПробы");
    УстановитьПривилегированныйРежим(Ложь);
    Вывод = Вывод + ПробаЧтения("normal.after");
    Попытка
        УстановитьОтключениеБезопасногоРежима(Истина);
        Вывод = Вывод + ПробаЧтения("suppression.only");
        УстановитьПривилегированныйРежим(Истина);
        Вывод = Вывод + ПробаЧтения("suppression.privileged");
        УстановитьПривилегированныйРежим(Ложь);
        УстановитьОтключениеБезопасногоРежима(Ложь);
        Вывод = Вывод + ПробаЧтения("suppression.after");
    Исключение
        Вывод = Вывод + "suppression.ERROR=" + ОписаниеОшибки() + Символы.ПС;
    КонецПопытки;
    Возврат Вывод;
КонецФункции
