&НаКлиенте
Процедура ПриОткрытии(Отказ)
    ПисательПробы = Новый ЗаписьТекста("/home/kan/Документы/develop/open-bsl/target/diagnostics/configuration-access-right-complete-native-1015/platform.oracle", "UTF-8");
    Попытка
        ПисательПробы.ЗаписатьСтроку(ВыполнитьПробу());
    Исключение
        ПисательПробы.ЗаписатьСтроку("ERROR=" + ОписаниеОшибки());
    КонецПопытки;
    ПисательПробы.ЗаписатьСтроку("completed=YES");
    ПисательПробы.Закрыть();
    ЗавершитьРаботуСистемы(Ложь);
КонецПроцедуры
&НаСервере
Функция ВыполнитьПробу()
    ПользовательПробы = ПользователиИнформационнойБазы.ТекущийПользователь();
    Если ПользовательПробы.Имя = "" Тогда
        Для Каждого ИмяПробы Из СтрРазделить("RootProbeAdmin,RootProbeDeny", ",") Цикл
            НовыйПользовательПробы = ПользователиИнформационнойБазы.СоздатьПользователя();
            НовыйПользовательПробы.Имя = ИмяПробы;
            НовыйПользовательПробы.АутентификацияСтандартная = Истина;
            НовыйПользовательПробы.Пароль = "";
            НовыйПользовательПробы.Роли.Добавить(?(ИмяПробы = "RootProbeAdmin", Метаданные.Роли.RootAllow, Метаданные.Роли.RootDeny));
            НовыйПользовательПробы.Записать();
        КонецЦикла;
        Возврат "users.created=YES";
    КонецЕсли;
    ВыводПробы = "right.user=" + ПользовательПробы.Имя + Символы.ПС;
    ВыводПробы = ВыводПробы + "right.current=" + ?(ПравоДоступа("СохранениеДанныхПользователя", Метаданные),"YES","NO") + Символы.ПС;
    ПроверкаПробы = "ERROR";
    Попытка ПроверкаПробы = ?(ПравоДоступа("СохранениеДанныхПользователя", Метаданные, ПользовательПробы),"YES","NO"); Исключение ПроверкаПробы = "ERROR:" + ОписаниеОшибки(); КонецПопытки;
    ВыводПробы = ВыводПробы + "right.self=" + ПроверкаПробы + Символы.ПС;
    ПроверкаПробы = "ERROR";
    Попытка ПроверкаПробы = ?(ПравоДоступа("СохранениеДанныхПользователя", Метаданные, Метаданные.Роли.RootDeny),"YES","NO"); Исключение ПроверкаПробы = "ERROR:" + ОписаниеОшибки(); КонецПопытки;
    ВыводПробы = ВыводПробы + "right.role.deny=" + ПроверкаПробы + Символы.ПС;
    ПроверкаПробы = "ERROR";
    Попытка ПроверкаПробы = ?(ПравоДоступа("Администрирование", Метаданные),"YES","NO"); Исключение ПроверкаПробы = "ERROR:" + ОписаниеОшибки(); КонецПопытки;
    ВыводПробы = ВыводПробы + "right.administration=" + ПроверкаПробы + Символы.ПС;
    ПроверкаПробы = "ERROR";
    Попытка ПроверкаПробы = ?(ПравоДоступа("Чтение", Метаданные),"YES","NO"); Исключение ПроверкаПробы = "ERROR:" + ОписаниеОшибки(); КонецПопытки;
    ВыводПробы = ВыводПробы + "right.inapplicable=" + ПроверкаПробы + Символы.ПС;
    ПроверкаПробы = "ERROR";
    Попытка ПроверкаПробы = ?(ПравоДоступа("UnknownProbeRight", Метаданные),"YES","NO"); Исключение ПроверкаПробы = "ERROR:" + ОписаниеОшибки(); КонецПопытки;
    ВыводПробы = ВыводПробы + "right.unknown=" + ПроверкаПробы + Символы.ПС;
    ВыводПробы = ВыводПробы + "right.role.admin=" + ?(ПравоДоступа("СохранениеДанныхПользователя", Метаданные, Метаданные.Роли.RootAllow),"YES","NO") + Символы.ПС;
    ВыводПробы = ВыводПробы + "right.role.save=" + ?(ПравоДоступа("СохранениеДанныхПользователя", Метаданные, Метаданные.Роли.RootSaveOnly),"YES","NO") + Символы.ПС;
    ВыводПробы = ВыводПробы + "right.role.save.ext=" + ?(AccessRight("ConfigurationExtensionsAdministration", Metadata, Metadata.Roles.RootSaveOnly),"YES","NO") + Символы.ПС;
    ВыводПробы = ВыводПробы + "right.role.ext.save=" + ?(AccessRight("SaveUserData", Metadata, Metadata.Roles.RootExtensionsOnly),"YES","NO") + Символы.ПС;
    ВыводПробы = ВыводПробы + "right.role.ext.ext=" + ?(AccessRight("ConfigurationExtensionsAdministration", Metadata, Metadata.Roles.RootExtensionsOnly),"YES","NO") + Символы.ПС;
    ВыводПробы = ВыводПробы + "right.role.processor=" + ?(AccessRight("InteractiveOpenExtDataProcessors", Metadata, Metadata.Roles.RootExternalProcessorOnly),"YES","NO") + Символы.ПС;
    ВыводПробы = ВыводПробы + "right.role.processor.save=" + ?(AccessRight("SaveUserData", Metadata, Metadata.Roles.RootExternalProcessorOnly),"YES","NO") + Символы.ПС;
    ВыводПробы = ВыводПробы + "right.role.processor.extensions=" + ?(AccessRight("ConfigurationExtensionsAdministration", Metadata, Metadata.Roles.RootExternalProcessorOnly),"YES","NO") + Символы.ПС;
    ВыводПробы = ВыводПробы + "right.role.report=" + ?(AccessRight("InteractiveOpenExtReports", Metadata, Metadata.Roles.RootExternalReportOnly),"YES","NO") + Символы.ПС;
    ВыводПробы = ВыводПробы + "right.role.report.processor=" + ?(AccessRight("InteractiveOpenExtDataProcessors", Metadata, Metadata.Roles.RootExternalReportOnly),"YES","NO") + Символы.ПС;
    УстановитьПривилегированныйРежим(Истина);
    ВыводПробы = ВыводПробы + "right.privileged.current=" + ?(ПравоДоступа("СохранениеДанныхПользователя", Метаданные),"YES","NO") + Символы.ПС;
    ВыводПробы = ВыводПробы + "right.privileged.role.deny=" + ?(ПравоДоступа("СохранениеДанныхПользователя", Метаданные, Метаданные.Роли.RootDeny),"YES","NO") + Символы.ПС;
    ПроверкаПробы = "ERROR";
    Попытка ПроверкаПробы = ?(ПравоДоступа("СохранениеДанныхПользователя", Метаданные, ПользовательПробы),"YES","NO"); Исключение ПроверкаПробы = "ERROR:" + ОписаниеОшибки(); КонецПопытки;
    ВыводПробы = ВыводПробы + "right.privileged.self=" + ПроверкаПробы + Символы.ПС;
    ПроверкаПробы = "ERROR";
    Попытка ПроверкаПробы = ?(ПравоДоступа("Администрирование", Метаданные),"YES","NO"); Исключение ПроверкаПробы = "ERROR:" + ОписаниеОшибки(); КонецПопытки;
    ВыводПробы = ВыводПробы + "right.privileged.administration=" + ПроверкаПробы + Символы.ПС;
    ПроверкаПробы = "ERROR";
    Попытка ПроверкаПробы = ?(ПравоДоступа("Чтение", Метаданные),"YES","NO"); Исключение ПроверкаПробы = "ERROR:" + ОписаниеОшибки(); КонецПопытки;
    ВыводПробы = ВыводПробы + "right.privileged.inapplicable=" + ПроверкаПробы + Символы.ПС;
    ПроверкаПробы = "ERROR";
    Попытка ПроверкаПробы = ?(ПравоДоступа("UnknownProbeRight", Метаданные),"YES","NO"); Исключение ПроверкаПробы = "ERROR:" + ОписаниеОшибки(); КонецПопытки;
    ВыводПробы = ВыводПробы + "right.privileged.unknown=" + ПроверкаПробы + Символы.ПС;

    УстановитьПривилегированныйРежим(Ложь);
    Возврат ВыводПробы;
КонецФункции
