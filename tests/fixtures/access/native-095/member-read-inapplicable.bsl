Процедура Проба(ИмяРоли, ВтораяРоль = "")
 Попытка
  Пользователь = ПользователиИнформационнойБазы.СоздатьПользователя();
  Пользователь.Имя = ИмяРоли;
  Пользователь.Роли.Добавить(Метаданные.Роли[ИмяРоли]);
  Если ВтораяРоль <> "" Тогда Пользователь.Роли.Добавить(Метаданные.Роли[ВтораяРоль]); КонецЕсли;
  Сообщить(ИмяРоли + ":object=" + Строка(ПравоДоступа("Чтение", Метаданные.Справочники.ЗамерВременныхТаблиц, Пользователь)));
  Сообщить(ИмяРоли + ":attribute=" + Строка(ПравоДоступа("Чтение", Метаданные.Справочники.ЗамерВременныхТаблиц.Реквизиты.ProbeAttribute, Пользователь)));
  Сообщить(ИмяРоли + ":code=" + Строка(ПравоДоступа("Чтение", Метаданные.Справочники.ЗамерВременныхТаблиц.СтандартныеРеквизиты.Код, Пользователь)));
  Сообщить(ИмяРоли + ":constant=" + Строка(ПравоДоступа("Чтение", Метаданные.Константы.ProbeConstant, Пользователь)));
 Исключение
  Сообщить(ИмяРоли + ":error=" + ОписаниеОшибки());
 КонецПопытки;
КонецПроцедуры
