Процедура ЗапросПроба(Имя, ТекстЗапроса)
 Попытка
  Данные = Новый Запрос(ТекстЗапроса);
  Результат = Данные.Выполнить();
  Сообщить(Имя + "=ok:" + Строка(Результат.Выгрузить().Количество()));
 Исключение
  Сообщить(Имя + "=error:" + ОписаниеОшибки());
 КонецПопытки;
КонецПроцедуры
Сообщить("file.begin query-rights-1");
Сообщить("user=" + ПользователиИнформационнойБазы.ТекущийПользователь().Имя);
ЗапросПроба("custom", "ВЫБРАТЬ ProbeAttribute ИЗ Справочник.ЗамерВременныхТаблиц");
ЗапросПроба("code", "ВЫБРАТЬ Код ИЗ Справочник.ЗамерВременныхТаблиц");
ЗапросПроба("constant", "ВЫБРАТЬ Значение ИЗ Константа.ProbeConstant");
Попытка
 Сообщить("get.constant=" + Строка(Константы.ProbeConstant.Получить()));
Исключение
 Сообщить("get.constant=error:" + ОписаниеОшибки());
КонецПопытки;
Сообщить("file.end query-rights-1");
