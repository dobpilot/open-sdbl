Процедура ПроверитьПравоПробы(КлючПробы, ПравоПробы, ОбъектМетаданныхПробы)
    Попытка
        ДоступПробы = ПравоДоступа(ПравоПробы, ОбъектМетаданныхПробы);
        РезультатПробы = ?(ДоступПробы, "true", "false");
    Исключение
        РезультатПробы = "error:" + ОписаниеОшибки();
    КонецПопытки;
    Сообщить(КлючПробы + Символ(9) + РезультатПробы);
КонецПроцедуры

РегистрМетаданныхПробы = Метаданные.РегистрыНакопления.ЗамерОстатков;
ПроверитьПравоПробы("owner.read", "Чтение", РегистрМетаданныхПробы);
ПроверитьПравоПробы("dimension.read", "Чтение", РегистрМетаданныхПробы.Измерения.Категория);
ПроверитьПравоПробы("dimension.view", "Просмотр", РегистрМетаданныхПробы.Измерения.Категория);
ПроверитьПравоПробы("resource.read", "Чтение", РегистрМетаданныхПробы.Ресурсы.Количество);
