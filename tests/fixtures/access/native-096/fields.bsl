Процедура ПробаЗапроса(ИмяПробы, ТекстПробы)
 Попытка
  ЗапросПробы = Новый Запрос(ТекстПробы);
  ТаблицаПробы = ЗапросПробы.Выполнить().Выгрузить();
  Сообщить(ИмяПробы + "=ok:" + Строка(ТаблицаПробы.Количество()));
 Исключение
  Сообщить(ИмяПробы + "=denied");
 КонецПопытки;
КонецПроцедуры
