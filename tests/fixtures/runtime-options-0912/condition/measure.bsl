// PLATFORM-ONLY: метаданные условного разделения отдельной базы замера.
Процедура М(Ид, Значение)
 Сообщить(Ид + Символ(9) + Строка(Значение));
КонецПроцедуры
М("file.begin", "common-attribute-condition-1");
Попытка
 РеквизитПробы = Метаданные.ОбщиеРеквизиты.НаименованиеЯзык1;
 М("COMMON_ATTRIBUTE_CONDITION.COUNT", РеквизитПробы.Состав.Количество());
 Для Каждого ЭлементПробы Из РеквизитПробы.Состав Цикл
  М("COMMON_ATTRIBUTE_CONDITION.OWNER", ЭлементПробы.Метаданные.ПолноеИмя());
  М("COMMON_ATTRIBUTE_CONDITION.USE", ЭлементПробы.Использование);
  М("COMMON_ATTRIBUTE_CONDITION.TYPE", ТипЗнч(ЭлементПробы.УсловноеРазделение));
  Если ЭлементПробы.УсловноеРазделение <> Неопределено Тогда
   М("COMMON_ATTRIBUTE_CONDITION.VALUE", ЭлементПробы.УсловноеРазделение.ПолноеИмя());
   М("COMMON_ATTRIBUTE_CONDITION.IDENTITY", ЭлементПробы.УсловноеРазделение = Метаданные.Константы.ЗначениеОпцииПробы);
  КонецЕсли;
 КонецЦикла;
Исключение
 М("COMMON_ATTRIBUTE_CONDITION.ERROR", ОписаниеОшибки());
КонецПопытки;
М("file.end", "common-attribute-condition-1");
