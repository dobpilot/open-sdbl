// PLATFORM-ONLY: порядок состава в отдельной базе условного разделения.
Процедура М(Ид, Значение)
 Сообщить(Ид + Символ(9) + Строка(Значение));
КонецПроцедуры
М("file.begin", "common-attribute-condition-ORDER_REVERSED-1");
Попытка
 РеквизитПробы = Метаданные.ОбщиеРеквизиты.НаименованиеЯзык1;
 М("COMMON_ATTRIBUTE_CONDITION_ORDER.ORDER_REVERSED_COUNT", РеквизитПробы.Состав.Количество());
 СтрокаСоставаПробы = "";
 Для Каждого ЭлементПробы Из РеквизитПробы.Состав Цикл
  УсловиеПробы = "undefined";
  Если ЭлементПробы.УсловноеРазделение <> Неопределено Тогда
   УсловиеПробы = ЭлементПробы.УсловноеРазделение.ПолноеИмя();
  КонецЕсли;
  СтрокаСоставаПробы = СтрокаСоставаПробы + ЭлементПробы.Метаданные.ПолноеИмя() + ":" + Строка(ЭлементПробы.Использование) + ":" + УсловиеПробы + ";";
 КонецЦикла;
 М("COMMON_ATTRIBUTE_CONDITION_ORDER.ORDER_REVERSED_CONTENT", СтрокаСоставаПробы);
Исключение
 М("COMMON_ATTRIBUTE_CONDITION_ORDER.ORDER_REVERSED_ERROR", ОписаниеОшибки());
КонецПопытки;
М("file.end", "common-attribute-condition-ORDER_REVERSED-1");
