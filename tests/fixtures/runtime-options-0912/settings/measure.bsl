

// Приёмник вывода: дописывает строку в файл. Открытие на каждой строке —
// сознательно: строк меньше сотни, зато нет ни модульных переменных, ни
// зависимости от того, переживает ли что-то серверный вызов.
&НаСервереБезКонтекста
Процедура СообщитьВФайл(Текст)
	Ф = Новый ЗаписьТекста("/tmp/sdbl0912-source-settings.platform.txt", , , Истина);
	Ф.ЗаписатьСтроку(Строка(Текст));
	Ф.Закрыть();
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ОчиститьФайлВывода()
	// Файл создаётся заново на каждом прогоне — иначе замеры копились бы.
	ФайлВывода = Новый ЗаписьТекста("/tmp/sdbl0912-source-settings.platform.txt");
	ФайлВывода.Закрыть();
КонецПроцедуры

&НаСервере
Процедура М(Ид, Значение)
	СообщитьВФайл(Ид + Символ(9) + Строка(Значение));
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ВыполнитьТестНаСервере();
	ЗавершитьРаботуСистемы(Ложь);
КонецПроцедуры

&НаСервере
Процедура ВыполнитьТестНаСервере()
	ОчиститьФайлВывода();

    Попытка
        Для Каждого Атрибут Из Метаданные.Справочники.ЗамерВременныхТаблиц.Реквизиты Цикл
            М("attribute", Атрибут.ПолноеИмя() + ":" + Строка(Атрибут.Use));
        КонецЦикла;
        Для Каждого РегистрПробы Из Метаданные.РегистрыСведений Цикл
            М("register", РегистрПробы.ПолноеИмя() + ":" + Строка(РегистрПробы.WriteMode) + ":" + Строка(РегистрПробы.InformationRegisterPeriodicity));
        КонецЦикла;
        Для Каждого ПараметрПробы Из Метаданные.ПараметрыФункциональныхОпций Цикл
            М("parameter", ПараметрПробы.ПолноеИмя() + ":" + Строка(ПараметрПробы.Use.Количество()));
        КонецЦикла;
        Для Каждого ЭлементПробы Из Метаданные.ОбщиеРеквизиты.НаименованиеЯзык1.Состав Цикл
            М("content", ЭлементПробы.Метаданные.ПолноеИмя() + ":" + Строка(ЭлементПробы.Использование));
        КонецЦикла;
    Исключение
        М("error", ОписаниеОшибки());
    КонецПопытки;
КонецПроцедуры
