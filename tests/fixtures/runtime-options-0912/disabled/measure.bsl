

// Приёмник вывода: дописывает строку в файл. Открытие на каждой строке —
// сознательно: строк меньше сотни, зато нет ни модульных переменных, ни
// зависимости от того, переживает ли что-то серверный вызов.
&НаСервереБезКонтекста
Процедура СообщитьВФайл(Текст)
	Ф = Новый ЗаписьТекста("/tmp/sdbl0912-applicability-full-disabled.platform.txt", , , Истина);
	Ф.ЗаписатьСтроку(Строка(Текст));
	Ф.Закрыть();
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ОчиститьФайлВывода()
	// Файл создаётся заново на каждом прогоне — иначе замеры копились бы.
	ФайлВывода = Новый ЗаписьТекста("/tmp/sdbl0912-applicability-full-disabled.platform.txt");
	ФайлВывода.Закрыть();
КонецПроцедуры

&НаСервере
Процедура М(Ид, Значение)
	СообщитьВФайл(Ид + Символ(9) + Строка(Значение));
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ВыполнитьТестНаСервере();
	ЗавершитьРаботуСистемы(Ложь);
КонецПроцедуры

&НаСервере
Процедура ВыполнитьТестНаСервере()
	ОчиститьФайлВывода();

	Попытка
        М("canary", Метаданные.ОбщиеРеквизиты.НаименованиеЯзык1.ПолноеИмя());
        Для Каждого Элемент Из Метаданные.ОбщиеРеквизиты.НаименованиеЯзык1.Состав Цикл
            М("content", Элемент.Метаданные.ПолноеИмя() + ":" + Строка(Элемент.Использование));
        КонецЦикла;
    Исключение
        М("error", ОписаниеОшибки());
    КонецПопытки;
КонецПроцедуры
